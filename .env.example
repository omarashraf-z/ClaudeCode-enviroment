# ── API ──────────────────────────────────────────────────────────────────────
PORT=4000
# Where the SQLite file lives, relative to apps/api
DATABASE_URL=data/gummybears.db
# The front end's origin. In development that's Vite; in production it's your
# domain. Used for CORS and for payment return URLs.
WEB_ORIGIN=http://localhost:5173

# ── The door (admin panel at /admin) ─────────────────────────────────────────
# Required in production. Development falls back to "letmein".
ADMIN_PASSWORD=
# Signs the admin session cookie. Required in production — without it every
# restart signs the door staff out. Generate: openssl rand -hex 32
SESSION_SECRET=

# ── Payments ─────────────────────────────────────────────────────────────────
# mock   — no money moves, bookings confirm instantly, tickets say
#          "pay at the door". This is the default.
# stripe — real Stripe Checkout. Needs the two keys below.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_PER_BOOKING=4
# Set to 1 only when running behind a proxy you control (rate limiting reads
# the client IP from X-Forwarded-For when this is on).
TRUST_PROXY=0
